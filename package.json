{
  "name": "@weibaohui/dsh-dashboard",
  "version": "0.1.3",
  "description": "dsh 插件 · 使用量仪表盘：离线扫描会话日志，统计每日/每周/每月 token、估算费用、模型/工具/技能/命令榜、输出速度、工作时段与质量指标；gridstack+ECharts 卡片可拖拽编排，支持自定义公式与 AI 编排（提示词往返导入）。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "dashboard",
    "usage",
    "tokens",
    "analytics",
    "heatmap"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/dsh-dashboard.git"
  },
  "homepage": "https://github.com/weibaohui/dsh-dashboard#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/dsh-dashboard/issues"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/fold.js && node --check src/presets.js && node --check client/index.js && node --check client/formula.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "echarts": "^5.6.0",
    "esbuild": "^0.25.0",
    "gridstack": "^12.0.0"
  }
}
